#!/bin/bash --norc
# glove-cc-prefix: Claude Code's CLAUDE_CODE_SHELL_PREFIX. Claude Code runs
# `<prefix> "<one shell string>"` for the Bash tool, `!` commands, hooks and MCP
# stdio servers; this hands that string to glove-tool, which runs it under the
# session's ring-1 tool wrapper, as for every harness. Anything unexpected fails
# closed with 126: no wrapper, no shell.
#
# The one exception is a glove-rendered stdio MCP server, whose string is
# exactly `<this prefix> --mcp <name>`: it runs /etc/claude-code/mcp-<name>.argv
# (read-only, one argument per line) under the harness's own sandbox, as Pi and
# Vibe run theirs, since the tool profile has no network to reach a sidecar. The
# agent cannot produce that string: every Bash/`!` string starts with Claude
# Code's snapshot `source`, and hooks are managed-only.
set -uo pipefail

if [ "$#" -ne 1 ]; then
  echo "glove: shell prefix expects one argument, got $# — shell blocked (fail closed)" >&2
  exit 126
fi
if [[ "$1" =~ ^/opt/glove/bin/glove-cc-prefix\ --mcp\ ([A-Za-z0-9_-]+)$ ]]; then
  f="/etc/claude-code/mcp-${BASH_REMATCH[1]}.argv"
  server=()  # read, not mapfile: the unit tests run this under macOS's bash 3.2
  if [ -r "$f" ]; then
    while IFS= read -r a || [ -n "$a" ]; do server+=("$a"); done < "$f"
  fi
  if [ "${#server[@]}" -eq 0 ] || [ -z "${server[0]}" ]; then
    echo "glove: no MCP server ${BASH_REMATCH[1]} — blocked (fail closed)" >&2
    exit 126
  fi
  exec "${server[@]}"
fi
# glove's managed hook refusing an MCP tool off the session's allowlist: exit 2,
# the one code that blocks a PreToolUse call (any other lets it prompt), so it
# never goes through a sandbox that could fail to start. Without an enforcer
# Claude Code runs the hook command itself: `<this prefix> --deny-mcp`.
if [ "$1" = "--deny-mcp" ] || [ "$1" = "/opt/glove/bin/glove-cc-prefix --deny-mcp" ]; then
  echo "glove: this MCP tool is not on the allowlist of this session" >&2
  exit 2
fi
exec /opt/glove/bin/glove-tool -c "$1"
