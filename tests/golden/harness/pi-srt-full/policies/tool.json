{
  "meta": {
    "name": "glove-tool"
  },
  "extends": "default",
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "/work",
      "/tmp"
    ],
    "read": [
      "/mnt/rag-models",
      "/etc/glove",
      "/opt/glove",
      "/usr/local",
      "/opt/pi"
    ]
  },
  "network": {
    "block": true
  },
  "environment": {
    "deny_vars": [
      "GLOVE_LLM_API_KEY",
      "*KEY*",
      "*TOKEN*",
      "*SECRET*",
      "*API_KEY*",
      "*CREDENTIAL*",
      "*PASSWORD*",
      "BROWSER_MCP_TOOLS",
      "BROWSER_MCP_URL",
      "BROWSER_MODE",
      "GLOVE_FETCH_PROXY",
      "SEARXNG_URL"
    ]
  },
  "security": {
    "signal_mode": "allow_same_sandbox"
  },
  "commands": {
    "allow": [
      "cp",
      "mv",
      "rm"
    ]
  }
}
