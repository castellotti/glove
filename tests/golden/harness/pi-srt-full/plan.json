{
  "command": [
    "/opt/glove/bin/glove-pty",
    "relay",
    "--",
    "/opt/glove/srt/node",
    "/opt/glove/srt/glove-srt.mjs",
    "/etc/glove/enforcer/srt-harness.json",
    "--",
    "/opt/glove/bin/glove-pty",
    "ctty",
    "--",
    "/usr/local/bin/node",
    "/usr/local/bin/pi",
    "-e",
    "/opt/glove/pi-extensions/enforcer"
  ],
  "enforcer_env": {},
  "environment": {
    "CLAUDE_OBSIDIAN_VAULT": "/work/data/store/vault",
    "GIT_CONFIG_PARAMETERS": "'safe.directory'='/work'",
    "HF_HUB_OFFLINE": "1",
    "KSTORE_EMBED_CACHE": "/mnt/rag-models",
    "KSTORE_EMBED_MODEL": "BAAI/bge-small-en-v1.5",
    "KSTORE_QUERY_STORES": "both",
    "PI_CODING_AGENT_DIR": "/home/agent/.pi/agent",
    "PI_CODING_AGENT_SESSION_DIR": "/home/agent/.pi/agent/sessions/--work--",
    "PI_OFFLINE": "1"
  },
  "image": "glove/pi:0.5.0-2fb80a890c-a86ddc93e6-srt-46f57ff955",
  "transcripts": [
    "<GLOVE_HOME>/observe/s/transcripts",
    "/home/agent/.pi/agent/sessions"
  ]
}
