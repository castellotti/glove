    "HF_HUB_OFFLINE": "1",
    "KSTORE_EMBED_CACHE": "/mnt/rag-models",
    "KSTORE_EMBED_MODEL": "BAAI/bge-small-en-v1.5",
    "KSTORE_QUERY_STORES": "both",
    "PI_CODING_AGENT_DIR": "/home/agent/.pi/agent",
    "PI_OFFLINE": "1",
    "SEARXNG_URL": "http://glove-s-search:8080"
  },
  "image": "glove/pi:0.5.0-faf71f952c-5aed97a86b-srt-46f57ff955",
  "transcripts": [
    "<GLOVE_HOME>/observe/s/transcripts",
    "/home/agent/.pi/agent/sessions"
  ]
