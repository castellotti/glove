{
  "command": [
    "/opt/glove/bin/glove-pty",
    "relay",
    "--",
    "/opt/glove/srt/node",
    "/opt/glove/srt/glove-srt.mjs",
    "/etc/glove/enforcer/srt-harness.json",
    "--",
    "/opt/glove/bin/glove-pty",
    "ctty",
    "--",
    "/usr/local/bin/node",
    "/usr/local/bin/pi",
    "-e",
    "/opt/glove/pi-extensions/enforcer",
    "-e",
    "/opt/glove/ext/playwright/pi-extension",
    "-e",
    "/opt/glove/ext/search/pi-extension",
    "-e",
    "/opt/glove/ext/webfetch/pi-extension"
  ],
  "enforcer_env": {},
  "environment": {
    "BROWSER_MCP_TOOLS": "browser_navigate,browser_navigate_back,browser_snapshot,browser_take_screenshot,browser_click,browser_type,browser_hover,browser_select_option,browser_press_key,browser_wait_for,browser_tabs,browser_handle_dialog",
    "BROWSER_MCP_URL": "http://glove-s-browser:8931/mcp",
    "BROWSER_MODE": "headless",
    "CLAUDE_OBSIDIAN_VAULT": "/work/data/store/vault",
