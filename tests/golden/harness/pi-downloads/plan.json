{
  "command": [
    "/opt/glove/bin/glove-pty",
    "relay",
    "--",
    "/opt/glove/srt/node",
    "/opt/glove/srt/glove-srt.mjs",
    "/etc/glove/enforcer/srt-harness.json",
    "--",
    "/opt/glove/bin/glove-pty",
    "ctty",
    "--",
    "/usr/local/bin/node",
    "/usr/local/bin/pi",
    "-e",
    "/opt/glove/pi-extensions/enforcer",
    "-e",
    "/opt/glove/ext/webfetch/pi-extension"
  ],
  "enforcer_env": {},
  "environment": {
    "GIT_CONFIG_PARAMETERS": "'safe.directory'='/work'",
    "GLOVE_DOWNLOAD_MCP_URL": "http://glove-s-webdownload-mcp:8000/mcp",
    "GLOVE_FETCH_PROXY": "http://glove-s-proxy:8888",
    "PI_CODING_AGENT_DIR": "/home/agent/.pi/agent",
    "PI_CODING_AGENT_SESSION_DIR": "/home/agent/.pi/agent/sessions/--work--",
    "PI_OFFLINE": "1"
  },
  "image": "glove/pi:0.5.0-5782abbef9-803e9927e7-srt-46f57ff955",
  "transcripts": [
    "<GLOVE_HOME>/observe/s/transcripts",
    "/home/agent/.pi/agent/sessions"
  ]
}
