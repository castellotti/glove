{
  "command": [
    "/opt/glove/bin/glove-pty",
    "relay",
    "--",
    "/opt/glove/srt/node",
    "/opt/glove/srt/glove-srt.mjs",
    "/etc/glove/enforcer/srt-harness.json",
    "--",
    "/opt/glove/bin/glove-pty",
    "ctty",
    "--",
    "/usr/local/bin/claude",
    "--add-dir",
    "/opt/glove/cc"
  ],
  "enforcer_env": {},
  "environment": {
    "ANTHROPIC_API_KEY": "glove-injected",
    "BROWSER_MCP_TOOLS": "browser_navigate,browser_navigate_back,browser_snapshot,browser_take_screenshot,browser_click,browser_type,browser_hover,browser_select_option,browser_press_key,browser_wait_for,browser_tabs,browser_handle_dialog",
    "BROWSER_MCP_URL": "http://glove-s-browser:8931/mcp",
    "BROWSER_MODE": "headless",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CONFIG_DIR": "/home/agent/.claude",
    "CLAUDE_OBSIDIAN_VAULT": "/work/data/store/vault",
    "DISABLE_AUTOUPDATER": "1",
    "GIT_CONFIG_PARAMETERS": "'safe.directory'='/work'",
    "HF_HUB_OFFLINE": "1",
    "KSTORE_EMBED_CACHE": "/mnt/rag-models",
    "KSTORE_EMBED_MODEL": "BAAI/bge-small-en-v1.5",
    "KSTORE_QUERY_STORES": "both"
  },
  "image": "glove/claude-code:0.2.0-dee1521c33-1a6d8b66c1-srt-46f57ff955",
  "passthrough_env": [],
  "transcripts": [
    "<GLOVE_HOME>/observe/s/transcripts",
    "/home/agent/.claude/projects"
  ]
}
