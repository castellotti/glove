# Generated by glove — derived image: glove/claude-code:0.2.0-dee1521c33-srt-46f57ff955 + extensions.
FROM glove/claude-code:0.2.0-dee1521c33-srt-46f57ff955
# extension: media
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg imagemagick webp libimage-exiftool-perl && rm -rf /var/lib/apt/lists/*
# extension: ocr
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng ocrmypdf poppler-utils ghostscript file && rm -rf /var/lib/apt/lists/*
COPY ocr/glove-ocr /usr/local/bin/glove-ocr
RUN chmod 0755 /usr/local/bin/glove-ocr
# extension: rag
RUN command -v pip3 >/dev/null || (apt-get update && apt-get install -y --no-install-recommends python3 python3-pip && rm -rf /var/lib/apt/lists/*)
RUN pip3 install --no-cache-dir --break-system-packages llama-index-core==0.14.25 llama-index-vector-stores-faiss==0.7.0 llama-index-readers-obsidian==0.8.0 fastembed==0.8.1 faiss-cpu==1.15.1
COPY rag/kstore /opt/glove/rag/kstore
COPY rag/kstore.sh /usr/local/bin/kstore
RUN chmod 0755 /usr/local/bin/kstore
# Claude Code: contributed skills (loaded with --add-dir)
RUN mkdir -p /opt/glove/cc/.claude/skills && ln -s /opt/glove/skills/rag/rag-parse /opt/glove/cc/.claude/skills/rag-parse && ln -s /opt/glove/skills/rag/rag-query /opt/glove/cc/.claude/skills/rag-query
# extension: rag (skill)
COPY rag/rag-parse /opt/glove/skills/rag/rag-parse
# extension: rag (skill)
COPY rag/rag-query /opt/glove/skills/rag/rag-query
