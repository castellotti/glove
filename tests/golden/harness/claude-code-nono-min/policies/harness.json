{
  "meta": {
    "name": "glove-harness"
  },
  "extends": "default",
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "/work",
      "/home/agent/.claude",
      "/tmp"
    ],
    "read": [
      "/etc/glove",
      "/opt/glove",
      "/run/glove/llm-ca",
      "/usr/local",
      "/etc/claude-code"
    ]
  },
  "network": {
    "block": false
  },
  "security": {
    "signal_mode": "allow_same_sandbox"
  }
}
