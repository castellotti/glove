{
  "meta": {
    "name": "glove-tool"
  },
  "extends": "default",
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "/work",
      "/tmp"
    ],
    "read": [
      "/work/downloads",
      "/etc/glove",
      "/opt/glove",
      "/opt/uv",
      "/usr/local"
    ]
  },
  "network": {
    "block": true
  },
  "environment": {
    "deny_vars": [
      "GLOVE_LLM_API_KEY",
      "*KEY*",
      "*TOKEN*",
      "*SECRET*",
      "*API_KEY*",
      "*CREDENTIAL*",
      "*PASSWORD*",
      "*COOKIE*",
      "*_PAT",
      "PAT_*",
      "*_PAT_*"
    ]
  },
  "security": {
    "signal_mode": "allow_same_sandbox"
  },
  "commands": {
    "allow": [
      "cp",
      "mv",
      "rm"
    ]
  }
}
