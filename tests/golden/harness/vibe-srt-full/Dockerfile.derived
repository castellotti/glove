FROM glove/vibe:0.5.0-srt-f5b44676c0
# extension: media
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg imagemagick webp libimage-exiftool-perl && rm -rf /var/lib/apt/lists/*
