# Generated by glove — derived image: glove/vibe:0.5.0-e3e5dcc731-srt-46f57ff955 + extensions.
FROM glove/vibe:0.5.0-e3e5dcc731-srt-46f57ff955
# extension: media
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg imagemagick webp libimage-exiftool-perl && rm -rf /var/lib/apt/lists/*
