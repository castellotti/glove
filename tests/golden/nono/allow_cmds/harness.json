{
  "meta": {
    "name": "glove-harness"
  },
  "extends": "default",
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "/work",
      "/tmp",
      "/home/agent/.pi/agent"
    ],
    "read": [
      "/etc/glove",
      "/opt/glove",
      "/usr/local",
      "/opt/pi"
    ]
  },
  "network": {
    "block": false
  },
  "security": {
    "signal_mode": "allow_same_sandbox"
  }
}
