{# fetch: the manifest's &mcp_fetch harnesses, by the endpoint it renders for them #}
{% set fetch, downloads = "webfetch-mcp" in endpoint, settings.downloads == "work" %}
services:
{% if fetch or downloads %}
{% set hop = endpoint['webfetch-egress'] if fetch else endpoint['webdownload-egress'] %}
{% set mcp_hosts = ([endpoint['webfetch-mcp'].host] if fetch else [])
                 + ([endpoint['webdownload-mcp'].host] if downloads else []) %}
  # The fetcher: Pi's and Vibe's fetch_url and, with downloads, web_download. Streamable
  # HTTP on :8000, reached only through the harness's `webfetch-mcp` and
  # `webdownload-mcp` forwarders (and only under those names: MCP_ALLOWED_HOST).
  # Every fetch goes through
  # {{ hop.url }} — the egress provider's proxy, or (with
  # observe) a gate in front of it per tool, and then the fetcher is not on the
  # egress network at all. Either network is internal, so it has no other way out.
  fetcher:
    image: "{{ images.mcp }}"
    command: ["python3", "/opt/glove/webfetch/webfetch_mcp.py"]  # the image's; core runs it after the CA bundle
{% if hop.interposed %}
    networks: [fetchnet]
{% else %}
    networks: [egress, fetchnet]
{% endif %}
    environment:
      # fetch_url is served when GLOVE_FETCH_PROXY is set, web_download when GLOVE_DOWNLOADS is
{% if fetch %}
      GLOVE_FETCH_PROXY: "{{ endpoint['webfetch-egress'].url }}"
{% endif %}
      GLOVE_FETCH_ALLOW: "{{ (slot.egress.get('guard_hosts', []) + slot.egress.get('guard_cidrs', [])) | join(',') }}"
      MCP_ALLOWED_HOST: "{{ mcp_hosts | join(':8000,') }}:8000"
{% if downloads %}
      GLOVE_DOWNLOAD_PROXY: "{{ endpoint['webdownload-egress'].url }}"
      # its only writable bind, the `downloads` output (core binds it): the
      # harness reads it at GLOVE_DOWNLOADS_SHOWN_AS and cannot write it
      GLOVE_DOWNLOADS: "{{ output.downloads.path }}"
      GLOVE_DOWNLOADS_SHOWN_AS: "{{ output.downloads.target }}"
      GLOVE_MIN_FREE: "{{ settings.min_free }}"
{% endif %}
    tmpfs: ["/tmp"]
    healthcheck:
      test: ["CMD", "python3", "-c", "import socket; socket.create_connection(('127.0.0.1', 8000), 2)"]
      interval: 3s
      timeout: 3s
      retries: 20
      start_period: 3s
{% endif %}
