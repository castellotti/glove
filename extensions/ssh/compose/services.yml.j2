services:
  # The ssh relay: relayd runs the harness's `ssh <host> <command>` (requests
  # left in the `ssh` channel) under relay_policy.py, with the key in an
  # ssh-agent here (loaded from its environment, hooks.py). Its only
  # network is sshnet, whose only other members are one forwarder per host
  # (glove-<id>-ssh-<name>), each dialling exactly that host.
  ssh:
    image: "{{ libs.relay.images.relayd }}"
    command: ["python3", "/opt/glove/relay/relayd.py", "--channel", "{{ channel.ssh.path }}",
              "--policy", "/opt/glove/ssh/relay_policy.py"]
    networks: [sshnet]
    environment:
      RELAY_TIMEOUT: "{{ settings.timeout }}"
      # each host, and its forwarder (hooks.py's `ssh-<name>` endpoint): the only route the sidecar has to it
      RELAY_SETTINGS: {{ {"hosts": settings.hosts, "forwarders": own_endpoints} | tojson | tojson }}
      RELAY_SSH_KEY:    # from glove's environment at `compose up` (hooks.py); never stored here
    volumes:
      - { type: bind, source: "{{ assets }}/relay_policy.py", target: /opt/glove/ssh/relay_policy.py,
          read_only: true }
      - { type: bind, source: "{{ state }}/known_hosts", target: /opt/glove/ssh/known_hosts, read_only: true }
    tmpfs: ["/tmp"]
    healthcheck:
      test: ["CMD", "test", "-p", "{{ channel.ssh.path }}/door"]
      interval: 2s
      timeout: 3s
      retries: 20
      start_period: 2s
