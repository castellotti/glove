#!/usr/bin/env bash
# glove `playwright` sidecar entrypoint.
#
#   glove-pw-start headless        the Playwright MCP, Chromium headless
#   glove-pw-start novnc           the same, headed on a TigerVNC display that
#                                  websockify + noVNC serve on 127.0.0.1:6080
#                                  (this container's loopback only)
#   glove-pw-start --probe-sandbox launch Chromium with its sandbox on; exit 0
#                                  and print "sandbox ok", or print why not
#
# Everything the agent could steer is fixed here, server-side: the proxy, the
# sandbox, the profile, headless or not. The MCP never gets a CDP port
# (Playwright launches Chromium over --remote-debugging-pipe).
set -euo pipefail

: "${PW_ALLOWED_HOST:?}" "${PW_PROXY:?}"
PW_SANDBOX=${PW_SANDBOX:-on}
PW_PROFILE=${PW_PROFILE:-ephemeral}
PW_VIEWPORT=${PW_VIEWPORT:-1280x800}
PW_OUTPUT=${PW_OUTPUT:-/data/output}
PW_UPLOADS=${PW_UPLOADS:-/data/uploads}

probe_sandbox() {
  node -e '
    const { chromium } = require("playwright-core");
    (async () => {
      try {
        const b = await chromium.launch({ channel: "chromium", chromiumSandbox: true, headless: true });
        const p = await b.newPage();
        await p.goto("about:blank");
        await b.close();
        console.log("sandbox ok");
      } catch (e) {
        console.log(String(e.message || e).split("\n").filter(l => /sandbox/i.test(l)).slice(0, 4).join("\n")
                    || String(e).slice(0, 400));
        process.exit(1);
      }
    })();'
}

mcp_args() {
  local args=(mcp --host 0.0.0.0 --port 8931 --allowed-hosts "$PW_ALLOWED_HOST"
    --browser chromium --proxy-server "$PW_PROXY" --output-dir "$PW_OUTPUT"
    --config /etc/glove/playwright/mcp.json --image-responses allow)
  if [ "$PW_SANDBOX" = on ]; then args+=(--sandbox); else args+=(--no-sandbox); fi
  if [ "$PW_PROFILE" = session ]; then args+=(--user-data-dir /data/profile); else args+=(--isolated); fi
  if [ -f "$STATE" ]; then args+=(--storage-state "$STATE"); fi
  printf '%s\n' "${args[@]}"
}

# With the sandbox on, prove it works before serving: a host that cannot give
# Chromium its namespaces fails here, at `glove up` (the healthcheck never
# passes), not at the agent's first page — and never silently without it.
require_sandbox() {
  [ "$PW_SANDBOX" = on ] || return 0
  if ! out=$(probe_sandbox); then
    printf 'glove: Chromium cannot use its sandbox here:\n%s\n' "$out" >&2
    printf 'glove: set `playwright: {chromium_sandbox: "off"}` to run without it (the container stays the boundary)\n' >&2
    exit 3
  fi
}

# The session's CAs (corporate_ca, `playwright: {ca: …}`), which glove put
# in NODE_EXTRA_CA_CERTS for Node (the MCP): Chromium verifies TLS against NSS,
# not Node's store, so import each certificate into the user's NSS db ($HOME
# is a tmpfs) as a trusted CA. Trust is only added; verification stays on.
trust_session_cas() {
  local ca="${NODE_EXTRA_CA_CERTS:-}" db="$HOME/.pki/nssdb" dir f
  [ -n "$ca" ] && [ -f "$ca" ] || return 0
  mkdir -p "$db"
  [ -f "$db/cert9.db" ] || certutil -d "sql:$db" -N --empty-password
  dir=$(mktemp -d)
  awk -v dir="$dir" '/-----BEGIN CERTIFICATE-----/ { n++; out = sprintf("%s/%03d.pem", dir, n) }
                     out { print > out } /-----END CERTIFICATE-----/ { close(out); out = "" }' "$ca"
  set -- "$dir"/*.pem
  [ -f "$1" ] || set --
  for f; do
    certutil -d "sql:$db" -A -n "glove-ca-$(basename "$f" .pem)" -t "C,," -i "$f"
  done
  rm -rf "$dir"
  echo "glove: trusting $# session CA certificate(s) from $ca" >&2
}

# `playwright: {storage_state: …}`: the session `glove playwright login`
# stored, handed over at `compose up` as gzip+base64 in PW_STORAGE_STATE (an
# env string tops out at 128 KB). Written 0600 to the tmpfs, and the variable
# unset before anything else starts; the MCP loads it into each new context.
STATE=/tmp/glove-state/storage-state.json
seed_storage_state() {
  [ -n "${PW_STORAGE_STATE:-}" ] || return 0
  (umask 077 && mkdir -p "${STATE%/*}" &&
    node -e 'process.stdout.write(require("zlib").gunzipSync(Buffer.from(process.env.PW_STORAGE_STATE, "base64")))' \
      > "$STATE")
  unset PW_STORAGE_STATE
  echo "glove: seeding the browser with a stored session" >&2
}

# The MCP deletes a staged download once it has copied it (image/glove-pw-staged.js)
MCP_NODE_OPTIONS="--require /opt/glove/pw/glove-pw-staged.js${NODE_OPTIONS:+ $NODE_OPTIONS}"

# Before the browser starts: the sandbox check, the CA, the stored session, and
# what a killed sidecar left behind: staged downloads (hooks.py STAGING; one the
# MCP had not finished copying) and Chromium's Singleton* locks in a persistent
# profile. A lock names `<hostname>-<pid>`, and
# each sidecar has a new hostname, so Chromium would refuse the profile as "in
# use by another computer" ("Browser is already in use for /data/profile"). No
# Chromium runs yet, and only this sidecar mounts the profile (its container_name
# is fixed, so the runtime removed the old one first): any lock is stale. A fixed
# hostname would not make Chromium clear it: the pid is from another namespace.
prepare() {
  require_sandbox
  find /data/staging -mindepth 1 -delete 2>/dev/null || true
  [ "$PW_PROFILE" != session ] || rm -f /data/profile/Singleton*
  trust_session_cas
  seed_storage_state
}

case "${1:-headless}" in
  --probe-sandbox)
    probe_sandbox
    ;;
  headless)
    prepare
    mapfile -t args < <(mcp_args)
    cd "$PW_UPLOADS"
    NODE_OPTIONS=$MCP_NODE_OPTIONS exec playwright-core "${args[@]}" --headless --viewport-size "$PW_VIEWPORT"
    ;;
  novnc)
    prepare
    in=0; [ "${VNC_ACCEPT_INPUT:-false}" = true ] && in=1
    case "${VNC_CLIPBOARD:-off}" in
      both) cin=1 cout=1 ;;
      to-browser) cin=1 cout=0 ;;
      *) cin=0 cout=0 ;;
    esac
    # Two random passwords per start (VncAuth uses 8 characters: ~48 bits),
    # generated here on the container's tmpfs: never in argv, env, a compose
    # secret or a host file. `glove playwright view` reads them via exec.
    umask 077
    mkdir -p /tmp/vnc
    for p in full view; do  # 6 random bytes → 8 base64url characters
      node -e 'process.stdout.write(require("crypto").randomBytes(6).toString("base64url"))' > "/tmp/vnc/$p"
    done
    # TigerVNC's password file: the full-access password, then the view-only one
    printf '%s\n%s\n' "$(cat /tmp/vnc/full)" "$(cat /tmp/vnc/view)" | vncpasswd -f > /tmp/vnc/passwd
    Xvnc :1 -geometry "$PW_VIEWPORT" -depth 24 -localhost -rfbport 5900 -nolisten tcp \
      -SecurityTypes VncAuth -PasswordFile /tmp/vnc/passwd -AlwaysShared \
      -AcceptSetDesktopSize=0 -AcceptKeyEvents="$in" -AcceptPointerEvents="$in" \
      -AcceptCutText="$cin" -SendCutText="$cout" -SetPrimary=0 -SendPrimary=0 &
    for _ in $(seq 50); do [ -S /tmp/.X11-unix/X1 ] && break; sleep 0.1; done
    websockify --web /usr/share/novnc 127.0.0.1:6080 127.0.0.1:5900 &
    mapfile -t args < <(mcp_args)
    (cd "$PW_UPLOADS" && DISPLAY=:1 NODE_OPTIONS=$MCP_NODE_OPTIONS exec playwright-core "${args[@]}") &
    # `dd_relay: true`: relayd serves the `dd` channel in this container, beside
    # this X display. It runs only the pinned commands image/relay_policy.py
    # allows. Detached (disown) so its death cannot end the container — `wait -n`
    # below then still only sees the tracked jobs above, and a dead relayd just
    # means `dd-exec` exits 127 (the agent falls back to the operator path).
    if [ "${PW_DD_RELAY:-false}" = true ]; then
      relayd --channel /run/glove/dd --policy /opt/glove/dd/relay_policy.py \
             --work /run/glove/dd --timeout "${PW_DD_TIMEOUT:-120}" --max 1 &
      disown
    fi
    # any tracked child's death ends the container (compose restarts it)
    wait -n
    exit $?
    ;;
  *)
    echo "usage: glove-pw-start headless|novnc|--probe-sandbox" >&2
    exit 2
    ;;
esac
