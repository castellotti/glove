services:
  # The github relay: relayd runs the harness's gh and network git commands
  # (requests left in the `github` channel) under relay_policy.py, with the
  # token in its environment (hooks.py). Children reach only GitHub's hosts,
  # through relayd's fence and then
  # {{ endpoint['github-egress'].url }} — the egress provider's proxy, or (with
  # observe) a gate in front of it, and then this sidecar is not on the egress
  # network at all. Either network is internal, so it has no other way out.
  gh:
    image: "{{ libs.relay.images.relayd }}"
    command: ["python3", "/opt/glove/relay/relayd.py", "--channel", "{{ channel.github.path }}",
              "--policy", "/opt/glove/github/relay_policy.py", "--work", "{{ work.target }}"]
{% if endpoint['github-egress'].interposed %}
    networks: [ghnet]
{% else %}
    networks: [egress, ghnet]
{% endif %}
    environment:
      RELAY_UPSTREAM: "{{ endpoint['github-egress'].url }}"
      RELAY_TIMEOUT: "{{ settings.timeout }}"
      RELAY_SETTINGS: {{ {"allow": settings.allow or []} | tojson | tojson }}
      RELAY_GITHUB_TOKEN:    # from glove's environment at `compose up` (hooks.py); never stored here
    working_dir: {{ work.target }}
    volumes:
      - { type: bind, source: "{{ work.host }}", target: "{{ work.target }}" }
      - { type: bind, source: "{{ assets }}/relay_policy.py", target: /opt/glove/github/relay_policy.py,
          read_only: true }
    tmpfs: ["/tmp"]
    healthcheck:
      test: ["CMD", "test", "-p", "{{ channel.github.path }}/door"]
      interval: 2s
      timeout: 3s
      retries: 20
      start_period: 2s
