#!/bin/sh
# glove-confine <command> [<arg>...]: run a plugin's stdio MCP server under the
# session's tool wrapper (the per-command sandbox: /work, /tmp, no network), as
# a shell command runs, never with the harness's own network. The wrapper is
# the enforcer's read-only argv, one argument per line; without one (no
# enforcer, or a broken session) nothing runs.
W=/etc/glove/enforcer/tool-wrapper.argv
[ -r "$W" ] && [ -s "$W" ] || { echo "glove-confine: no tool wrapper ($W) — not started" >&2; exit 126; }
n=$#
while IFS= read -r a; do set -- "$@" "$a"; done < "$W"
# the wrapper's arguments were appended: rotate the command's n to the end
while [ "$n" -gt 0 ]; do a=$1; shift; set -- "$@" "$a"; n=$((n - 1)); done
exec "$@"
