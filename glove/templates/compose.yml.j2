# Generated by glove — do not edit by hand.
# Session: {{ session }}   Harness: {{ harness.name }}
name: glove-{{ session }}

services:

  # --- harness: the sandboxed agent (internal net only, hardened) ------------
  glove-{{ session }}-harness:
    container_name: glove-{{ session }}-harness
    image: {{ harness_image }}
    working_dir: {{ working_dir }}
    command: {{ command | tojson }}
    stdin_open: true
    tty: true
    # --- hardening set (PLAN §3.2); `allow_root` only drops the non-root user --
{% if not allow_root %}
    user: "{{ uid }}:{{ gid }}"
{% endif %}
    ipc: {{ hardening.ipc }}
    cap_drop:
      - ALL
{% if hardening.cap_add %}
    cap_add:
{% for c in hardening.cap_add %}
      - {{ c }}
{% endfor %}
{% endif %}
    security_opt:
      - "no-new-privileges:true"
      - "seccomp={{ hardening.seccomp_profile }}"
{% if hardening.systempaths_unconfined %}
      - "systempaths=unconfined"
{% endif %}
    read_only: true
    pids_limit: {{ hardening.limits.pids }}
    mem_limit: {{ hardening.limits.memory }}
    cpus: {{ hardening.limits.cpus }}
    environment:
      HOME: "/home/agent"
{% for k, v in environment.items() %}
      {{ k }}: {{ v | tojson }}
{% endfor %}
{% for k, v in enforcer_env.items() %}
      {{ k }}: {{ v | tojson }}
{% endfor %}
    volumes:
      - type: bind
        source: {{ home_dir | tojson }}
        target: /home/agent
{% if policies_host_dir %}
      # ring-1 enforcer policies (read-only; never inside /work, PLAN §4.1)
      - type: bind
        source: {{ policies_host_dir | tojson }}
        target: {{ policies_container_dir }}
        read_only: true
{% endif %}
{% for m in mounts %}
      - type: bind
        source: {{ m.host_path | tojson }}
        target: {{ m.container_path }}
{% if m.read_only %}
        read_only: true
{% endif %}
{% endfor %}
{% for t in hardening.tmpfs %}
      # writable tmpfs (mode 01777, YAML octal → 1777) — listed after the binds so
      # a target nested under /home/agent overlays the bind. mode is forced
      # explicitly: over a mountpoint that already exists on the bind, a bare
      # tmpfs mounts 755 root:root and the non-root harness can't write it.
      # Enforcer state (e.g. nono's control socket, which the macOS/Windows bind
      # mount can't host) lives here; the agent's Landlock policy still denies it.
      - type: tmpfs
        target: {{ t }}
        tmpfs:
          mode: 01777
{% endfor %}
    networks:
      - glove-{{ session }}-net
{% for net in harness_extra_networks %}
      - {{ net }}
{% endfor %}
{% if harness_host_gateway %}
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% endif %}
{% for s in sidecars %}

  # --- forwarder: {{ s.role }} -> {{ s.target }}
  glove-{{ session }}-{{ s.role }}:
    container_name: glove-{{ session }}-{{ s.role }}
    image: {{ forwarder_image }}
    command: {{ s.command | tojson }}
    restart: unless-stopped
    networks:
      - glove-{{ session }}-net
{% if s.join_network %}
      - {{ s.join_network }}
{% endif %}
{% if s.host_gateway and egress_network %}
      - {{ egress_network }}
{% endif %}
{% if s.host_gateway %}
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% endif %}
{% endfor %}

networks:
  glove-{{ session }}-net:
    name: glove-{{ session }}-net
    internal: true
{% if egress_network %}
  {{ egress_network }}:
    name: {{ egress_network }}
{% endif %}
{% for net in external_networks %}
  {{ net }}:
    external: true
    name: {{ net }}
{% endfor %}
