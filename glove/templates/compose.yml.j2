# Generated by glove — do not edit by hand.
# Session: {{ session }}   Harness: {{ harness.name }}
name: glove-{{ session }}
{% macro gate_hardening() %}
    # gate hardening: non-root, no caps, no privilege gain, read-only rootfs.
    # Never NET_ADMIN, never the harness's network/PID namespace, never its home.
    user: "{{ uid }}:{{ gid }}"
{% if userns_mode %}
    userns_mode: "{{ userns_mode }}"
{% endif %}
    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"
    read_only: true
    pids_limit: 64
    mem_limit: 256m
{% endmacro %}

services:

  # --- harness: the sandboxed agent (internal net only, hardened) ------------
  glove-{{ session }}-harness:
    container_name: glove-{{ session }}-harness
    image: {{ harness_image }}
    working_dir: {{ working_dir }}
    command: {{ command | tojson }}
    stdin_open: true
    tty: true
    # --- hardening set (PLAN §3.2); `allow_root` only drops the non-root user --
{% if not allow_root %}
    user: "{{ uid }}:{{ gid }}"
{% endif %}
{% if userns_mode %}
    # rootless podman: map the host uid/gid through so the non-root user owns
    # (and can write) the bind-mounted home and workdir.
    userns_mode: "{{ userns_mode }}"
{% endif %}
    ipc: {{ hardening.ipc }}
    cap_drop:
      - ALL
{% if hardening.cap_add %}
    cap_add:
{% for c in hardening.cap_add %}
      - {{ c }}
{% endfor %}
{% endif %}
    security_opt:
      - "no-new-privileges:true"
{% if emit_seccomp %}
      - "seccomp={{ hardening.seccomp_profile }}"
{% else %}
      # podman: the compose provider inlines a referenced seccomp file, which
      # podman's compat API rejects — rely on podman's built-in default profile
      # (same moby-derived filter, allows landlock_*).
{% endif %}
{% if hardening.systempaths_unconfined %}
      - "systempaths=unconfined"
{% endif %}
    read_only: true
    pids_limit: {{ hardening.limits.pids }}
    mem_limit: {{ hardening.limits.memory }}
    cpus: {{ hardening.limits.cpus }}
    environment:
      HOME: "/home/agent"
{% for k, v in environment.items() %}
      {{ k }}: {{ v | tojson }}
{% endfor %}
{% for k, v in enforcer_env.items() %}
      {{ k }}: {{ v | tojson }}
{% endfor %}
    volumes:
      - type: bind
        source: {{ home_dir | tojson }}
        target: /home/agent
{% if policies_host_dir %}
      # ring-1 enforcer policies (read-only; never inside /work, PLAN §4.1)
      - type: bind
        source: {{ policies_host_dir | tojson }}
        target: {{ policies_container_dir }}
        read_only: true
{% endif %}
{% for m in mounts %}
      - type: bind
        source: {{ m.host_path | tojson }}
        target: {{ m.container_path }}
{% if m.read_only %}
        read_only: true
{% endif %}
{% endfor %}
{% for t in hardening.tmpfs %}
      # writable tmpfs (mode 01777, YAML octal → 1777) — listed after the binds so
      # a target nested under /home/agent overlays the bind. mode is forced
      # explicitly: over a mountpoint that already exists on the bind, a bare
      # tmpfs mounts 755 root:root and the non-root harness can't write it.
      # Enforcer state (e.g. nono's control socket, which the macOS/Windows bind
      # mount can't host) lives here; the agent's Landlock policy still denies it.
      - type: tmpfs
        target: {{ t }}
        tmpfs:
          mode: 01777
{% endfor %}
    networks:
      - glove-{{ session }}-net
{% for net in harness_extra_networks %}
      - {{ net }}
{% endfor %}
{% if harness_host_gateway %}
    extra_hosts:
      - "{{ host_gateway_name }}:host-gateway"
{% endif %}
{% for s in sidecars %}
{% if s.gate %}

  # --- netgate forwarder (observed, {{ s.gate.mode }}): {{ s.role }} -> {{ s.target }}
  # A drop-in for the socat forwarder: same name, networks and port.
  glove-{{ session }}-{{ s.role }}:
    container_name: glove-{{ session }}-{{ s.role }}
    image: {{ netgate_image }}
    command: {{ gate_commands[s.role] | tojson }}
    restart: unless-stopped
{{ gate_hardening() }}
    volumes:
      # flow records go to the collector over a unix socket; no network API.
      - type: volume
        source: glove-{{ session }}-netgate-events
        target: {{ events_dir }}
      # rules.json (directory mount: atomic-rename writes stay visible)
      - type: bind
        source: {{ control_host_dir | tojson }}
        target: {{ control_container_dir }}
        read_only: true
    depends_on:
      - glove-{{ session }}-netgate
    networks:
{% if s.harness %}
      glove-{{ session }}-net:
        aliases:
          - {{ gate_aliases[s.role] }}
{% endif %}
{% if s.join_network %}
      {{ s.join_network }}: {}
{% endif %}
{% if s.host_gateway and egress_network %}
      {{ egress_network }}: {}
{% endif %}
{% if s.host_gateway %}
    extra_hosts:
      - "{{ host_gateway_name }}:host-gateway"
{% endif %}
{% else %}

  # --- forwarder: {{ s.role }} -> {{ s.target }}
  glove-{{ session }}-{{ s.role }}:
    container_name: glove-{{ session }}-{{ s.role }}
    image: {{ forwarder_image }}
    command: {{ s.command | tojson }}
    restart: unless-stopped
    networks:
{% if s.harness %}
      - glove-{{ session }}-net
{% endif %}
{% if s.join_network %}
      - {{ s.join_network }}
{% endif %}
{% if s.host_gateway and egress_network %}
      - {{ egress_network }}
{% endif %}
{% if s.host_gateway %}
    extra_hosts:
      - "{{ host_gateway_name }}:host-gateway"
{% endif %}
{% endif %}
{% endfor %}
{% if netgate %}

  # --- netgate collector: the single writer of the session's net/ dir.
  # network_mode none: it has no interface, so it can expose no API anywhere.
  glove-{{ session }}-netgate:
    container_name: glove-{{ session }}-netgate
    image: {{ netgate_image }}
    command: {{ collect_command | tojson }}
    restart: unless-stopped
    network_mode: none
{{ gate_hardening() }}
    volumes:
      - type: bind
        source: {{ net_host_dir | tojson }}
        target: {{ net_container_dir }}
      - type: volume
        source: glove-{{ session }}-netgate-events
        target: {{ events_dir }}
      - type: bind
        source: {{ control_host_dir | tojson }}
        target: {{ control_container_dir }}
        read_only: true
{% endif %}

networks:
  glove-{{ session }}-net:
    name: glove-{{ session }}-net
    internal: true
{% if egress_network %}
  {{ egress_network }}:
    name: {{ egress_network }}
{% endif %}
{% for net in external_networks %}
  {{ net }}:
    external: true
    name: {{ net }}
{% endfor %}
{% if netgate %}

volumes:
  # tmpfs-backed and owned by the operator uid: holds only the collector's
  # datagram socket. Mounted by the gate containers, never by the harness.
  glove-{{ session }}-netgate-events:
    name: glove-{{ session }}-netgate-events
    driver: local
    driver_opts:
      type: tmpfs
      device: tmpfs
      o: "size=1m,mode=0700,uid={{ uid }},gid={{ gid }}"
{% endif %}
