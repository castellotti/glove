# Generated by glove — do not edit by hand.
# Session: {{ session }}   Harness: {{ harness.name }}
name: glove-{{ session }}
{% macro forwarder_hardening() %}
    # sidecar hardening (every forwarder): non-root, no caps, no privilege gain,
    # read-only rootfs, pids/memory limits. Never NET_ADMIN, never the harness's
    # network/PID namespace, never its home. No host binds, so never keep-id:
    # its uid stays an unprivileged subuid on rootless podman.
    user: "{{ uid }}:{{ gid }}"
    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"
    read_only: true
    pids_limit: 64
    mem_limit: 256m
{% endmacro %}

services:

  # --- harness: the sandboxed agent (internal net only, hardened) ------------
  glove-{{ session }}-harness:
    container_name: glove-{{ session }}-harness
    image: {{ harness_image }}
    working_dir: {{ working_dir }}
    command: {{ command | tojson }}
    stdin_open: true
    tty: true
    # --- hardening set (PLAN §3.2); `allow_root` only drops the non-root user --
{% if not allow_root %}
    user: "{{ uid }}:{{ gid }}"
{% endif %}
{% if userns_mode %}
    # rootless podman: map the host uid/gid through so the non-root user owns
    # (and can write) the bind-mounted home and workdir.
    userns_mode: "{{ userns_mode }}"
{% endif %}
    ipc: {{ hardening.ipc }}
    cap_drop:
      - ALL
{% if hardening.cap_add %}
    cap_add:
{% for c in hardening.cap_add %}
      - {{ c }}
{% endfor %}
{% endif %}
    security_opt:
      - "no-new-privileges:true"
{% if emit_seccomp %}
      - "seccomp={{ hardening.seccomp_profile }}"
{% else %}
      # podman: the compose provider inlines a referenced seccomp file, which
      # podman's compat API rejects — rely on podman's built-in default profile
      # (same moby-derived filter, allows landlock_*).
{% endif %}
{% if hardening.systempaths_unconfined %}
      - "systempaths=unconfined"
{% endif %}
    read_only: true
    pids_limit: {{ hardening.limits.pids }}
    mem_limit: {{ hardening.limits.memory }}
    cpus: {{ hardening.limits.cpus }}
    environment:
      HOME: {{ home.container_path | tojson }}
{% for k, v in environment.items() %}
      {{ k }}: {{ v | tojson }}
{% endfor %}
{% for k, v in enforcer_env.items() %}
      {{ k }}: {{ v | tojson }}
{% endfor %}
    volumes:
      - type: bind
        source: {{ home.host_path | tojson }}
        target: {{ home.container_path }}
{% if policies_host_dir %}
      # ring-1 enforcer policies (read-only; never inside /work, PLAN §4.1)
      - type: bind
        source: {{ policies_host_dir | tojson }}
        target: {{ policies_container_dir }}
        read_only: true
{% endif %}
{% for host, target in system_mounts %}
      # the harness's own system config (read-only; outside its writable home)
      - type: bind
        source: {{ host | tojson }}
        target: {{ target }}
        read_only: true
{% endfor %}
{% if corporate_ca_host_path %}
      # corporate_ca: a public CA certificate the harness trusts in addition to
      # the public roots (NODE_EXTRA_CA_CERTS); read-only, never a secret
      - type: bind
        source: {{ corporate_ca_host_path | tojson }}
        target: {{ corporate_ca_container_path }}
        read_only: true
{% endif %}
{% for m in mounts %}
      - type: bind
        source: {{ m.host_path | tojson }}
        target: {{ m.container_path }}
{% if m.read_only %}
        read_only: true
{% endif %}
{% endfor %}
{% for p in protect %}
{% if p.host_path or placeholder_host_dir %}
      # ring 0: {{ "read-only over a path the host or the harness later runs or trusts" if p.read_only
      else "re-bound so it is a mount point and cannot be renamed away" }}
      # (after the rw bind it sits in, so it overlays it)
      - type: bind
        source: {{ (p.host_path or placeholder_host_dir ~ "/" ~ p.name) | tojson }}
        target: {{ p.container_path | tojson }}
{% if p.read_only %}
        read_only: true
{% endif %}
{% endif %}
{% endfor %}
{% if transcripts_host_dir %}
      # observe export: the harness writes its transcripts straight into
      # ~/.glove/observe/<id>/transcripts (after the home bind, so it overlays it)
      - type: bind
        source: {{ transcripts_host_dir | tojson }}
        target: {{ transcripts_container_dir | tojson }}
{% endif %}
{% for c in channels %}
      # channel {{ c.name }} ({{ c.extension }}): a directory shared with its
      # sidecar(s) {{ c.services | join(", ") }} (session tmpfs; no network)
      - type: volume
        source: {{ c.volume(session) }}
        target: {{ c.path }}
{% if c.read_only %}
        read_only: true  # its sidecar(s) write it; the harness only reads
{% endif %}
{% endfor %}
{% for t in hardening.tmpfs %}
      # writable tmpfs (mode 01777, YAML octal → 1777) — listed after the binds so
      # a target nested under the home overlays the bind. mode is forced
      # explicitly: over a mountpoint that already exists on the bind, a bare
      # tmpfs mounts 755 root:root and the non-root harness can't write it.
      # Enforcer state (e.g. nono's control socket, which the macOS/Windows bind
      # mount can't host) lives here; the agent's Landlock policy still denies it.
      - type: tmpfs
        target: {{ t }}
        tmpfs:
          mode: 01777
{% endfor %}
    networks:
      - glove-{{ session }}-net
{% for s in sidecars %}

  # --- forwarder: {{ s.role }} -> {{ s.target }}
  glove-{{ session }}-{{ s.role }}:
    container_name: glove-{{ session }}-{{ s.role }}
    image: {{ forwarder_image }}
{% if s.entrypoint %}
    entrypoint: {{ s.entrypoint | tojson }}
{% endif %}
    command: {{ s.command | tojson }}
    restart: unless-stopped
{{ forwarder_hardening() }}
{% if s.listen_port < 1024 %}
    # a low port as non-root: podman does not default this (docker does);
    # namespaced to this forwarder's own network namespace
    sysctls:
      net.ipv4.ip_unprivileged_port_start: 0
{% endif %}
    networks:
{% if s.harness and s.aliases %}
      glove-{{ session }}-net:
        aliases:
{% for a in s.aliases %}
          - {{ a }}
{% endfor %}
{% elif s.harness %}
      glove-{{ session }}-net: {}
{% endif %}
{% for n in s.networks %}
      {{ n }}: {}
{% endfor %}
{% if s.host_gateway and hostgw_network %}
      {{ hostgw_network }}: {}
{% endif %}
{% if s.host_gateway %}
    extra_hosts:
      - "{{ host_gateway_name }}:host-gateway"
{% endif %}
{% endfor %}
{% if extension_services %}

  # --- extension sidecars (validated + hardened by glove/compose.py) ---------
{{ extension_services }}{% endif %}

networks:
  glove-{{ session }}-net:
    name: glove-{{ session }}-net
    internal: true
{% if subnets.get("glove-" ~ session ~ "-net") %}
    ipam:
      config:
        - subnet: {{ subnets["glove-" ~ session ~ "-net"] }}
{% endif %}
{% if hostgw_network %}
  {{ hostgw_network }}:
    name: {{ hostgw_network }}
{% if subnets.get(hostgw_network) %}
    ipam:
      config:
        - subnet: {{ subnets[hostgw_network] }}
{% endif %}
{% endif %}
{% for net, internal in session_networks.items() %}
  {{ net }}:
    name: {{ net }}
{% if internal %}
    internal: true
{% endif %}
{% if subnets.get(net) %}
    ipam:
      config:
        - subnet: {{ subnets[net] }}
{% endif %}
{% endfor %}
{% if extension_volumes %}

volumes:
{{ extension_volumes }}{% endif %}
{% if extension_secrets %}

secrets:
  # values come from glove's environment at `compose up`; never stored here
{{ extension_secrets }}{% endif %}
