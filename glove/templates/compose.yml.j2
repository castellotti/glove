# Generated by glove — do not edit by hand.
# Session: {{ session }}   Harness: {{ harness.name }}
name: glove-{{ session }}

services:

  # --- harness: the sandboxed agent (internal net only, hardened) ------------
  glove-{{ session }}-harness:
    container_name: glove-{{ session }}-harness
    image: {{ harness_image }}
    working_dir: {{ working_dir }}
    command: {{ harness.entry | tojson }}
    stdin_open: true
    tty: true
{% if not allow_root %}
    user: "{{ uid }}:{{ gid }}"
    security_opt:
      - "no-new-privileges:true"
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
{% endif %}
    environment:
      HOME: "/home/agent"
{% for k, v in environment.items() %}
      {{ k }}: {{ v | tojson }}
{% endfor %}
    volumes:
      - type: bind
        source: {{ home_dir | tojson }}
        target: /home/agent
{% for m in mounts %}
      - type: bind
        source: {{ m.host_path | tojson }}
        target: {{ m.container_path }}
{% if m.read_only %}
        read_only: true
{% endif %}
{% endfor %}
    networks:
      - glove-{{ session }}-net
{% for net in harness_extra_networks %}
      - {{ net }}
{% endfor %}
{% if harness_host_gateway %}
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% endif %}
{% for s in sidecars %}

  # --- forwarder: {{ s.role }} -> {{ s.target }}
  glove-{{ session }}-{{ s.role }}:
    container_name: glove-{{ session }}-{{ s.role }}
    image: {{ forwarder_image }}
    command: {{ s.command | tojson }}
    restart: unless-stopped
    networks:
      - glove-{{ session }}-net
{% if s.join_network %}
      - {{ s.join_network }}
{% endif %}
{% if s.host_gateway and egress_network %}
      - {{ egress_network }}
{% endif %}
{% if s.host_gateway %}
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% endif %}
{% endfor %}

networks:
  glove-{{ session }}-net:
    name: glove-{{ session }}-net
    internal: true
{% if egress_network %}
  {{ egress_network }}:
    name: {{ egress_network }}
{% endif %}
{% for net in external_networks %}
  {{ net }}:
    external: true
    name: {{ net }}
{% endfor %}
